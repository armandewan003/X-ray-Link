[Unit]
Description=X-RAY LINK Central Backend API & WebSocket Service
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=xraylink
WorkingDirectory=/opt/x-ray-link/backend
EnvironmentFile=/opt/x-ray-link/.env
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/x-ray-link/data

[Install]
WantedBy=multi-user.target
